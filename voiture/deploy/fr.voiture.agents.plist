<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Lance le serveur au démarrage du Mac et le relance s'il s'arrête.
     Remplacez CHEMIN_DU_DEPOT par le chemin absolu du dossier voiture, puis :
     cp deploy/fr.voiture.agents.plist ~/Library/LaunchAgents/
     launchctl load ~/Library/LaunchAgents/fr.voiture.agents.plist -->
<plist version="1.0">
<dict>
  <key>Label</key><string>fr.voiture.agents</string>
  <key>WorkingDirectory</key><string>CHEMIN_DU_DEPOT</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/zsh</string><string>-lc</string>
    <string>set -a; source .env; set +a; exec .venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8000</string>
  </array>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>StandardOutPath</key><string>CHEMIN_DU_DEPOT/data/serveur.log</string>
  <key>StandardErrorPath</key><string>CHEMIN_DU_DEPOT/data/serveur.log</string>
</dict>
</plist>
