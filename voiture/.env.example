# Copiez ce fichier en .env et remplissez-le.
ANTHROPIC_API_KEY=sk-ant-...
# Mot de passe de l'app (laissez vide pour en générer un au premier lancement : il s'affiche dans les logs)
VOITURE_APP_TOKEN=
# Adresse de contact pour les notifications Web Push (obligatoire pour Apple)
VOITURE_VAPID_CONTACT=mailto:vous@example.com
# Modèles (par défaut claude-opus-5-5 partout)
# VOITURE_CHEF_MODEL=claude-opus-5-5
# VOITURE_AGENT_MODEL=claude-opus-5-5
# Limites par mission
# VOITURE_MAX_AGENT_CALLS=10
